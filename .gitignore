# ------------------------------
# Data: keep structure, ignore real contents
# ------------------------------
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Optional local datasets outside data/
datasets/

# Heavy file formats (prevent accidental commits)
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.npz
*.npy
*.zip
*.7z
*.tar
*.gz

# ------------------------------
# Reports/artifacts generated automatically
# ------------------------------
reports/figures/*
!reports/figures/.gitkeep

reports/results/*
!reports/results/.gitkeep

# ------------------------------
# Python
# ------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments / local env
.venv/
venv/
.env

# Jupyter checkpoints and executed outputs
*.nbconvert.ipynb

# ------------------------------
# OS/editor
# ------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
